{
  "name": "local-memory",
  "version": "0.1.0",
  "description": "Sharlie learns lessons from local AI coding chats and keeps them on this PC.",
  "author": "Liviu",
  "private": true,
  "type": "module",
  "main": "electron/start.mjs",
  "scripts": {
    "test": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test test/gate.test.ts test/card.test.ts test/tools.test.ts test/import.test.ts test/publish.test.ts test/lookup.test.ts test/graph.test.ts test/display.test.ts test/session.test.ts test/window.test.ts test/host.test.ts test/relay.test.ts test/mcp.test.ts test/learning-progress.test.ts test/hostile-config.test.ts test/smoke-learn.test.ts test/kb.test.ts",
    "bench:graph": "node scripts/graph-bench.mjs",
    "test:ui": "playwright test",
    "relay": "node relay/run.ts",
    "start": "node scripts/compile-main.mjs && node electron/dev.mjs",
    "check": "tsc --noEmit",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "compile": "node scripts/compile-main.mjs",
    "electron:build": "npm run ui:build && npm run compile && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@cosmos.gl/graph": "^3.5.1",
    "@cursor/sdk": "^1.2.0",
    "@napi-rs/keyring": "^2.1.2",
    "neo4j-driver": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "app.sharlie.local",
    "productName": "Sharlie",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/start.mjs",
      "electron/dist/main.mjs",
      "electron/preload.cjs",
      "electron/installer.nsh",
      "ui/dist/**",
      "package.json",
      "node_modules/@napi-rs/keyring/**",
      "node_modules/@napi-rs/keyring-win32-x64-msvc/**"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/keyring-win32-x64-msvc/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "include": "electron/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
